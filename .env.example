# -----------------------------------------------------------------------------
# Krona Express - variaveis de ambiente (exemplo)
#
# Copie este arquivo para `.env.local` e preencha os valores.
# NENHUMA das integracoes abaixo esta implementada nesta etapa: os campos
# existem apenas como contrato para as fases seguintes do projeto.
# Nunca versione `.env.local` nem qualquer valor real.
# -----------------------------------------------------------------------------

# --- Site --------------------------------------------------------------------
# URL publica canonica. Usada futuramente em metadata, sitemap e Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- WhatsApp (futuro) -------------------------------------------------------
# Numero em formato internacional, somente digitos. Ex.: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# --- Resend (futuro) ---------------------------------------------------------
# Envio transacional dos formularios de contato e cotacao.
RESEND_API_KEY=""
# Remetente verificado no dominio configurado na Resend.
CONTACT_FROM_EMAIL=""
# Caixa que recebe os formularios enviados pelo site.
CONTACT_TO_EMAIL=""

# --- Supabase (futuro) -------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Chave privada: exclusiva de server-side. Jamais expor ao cliente.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Cloudflare Turnstile (futuro) -------------------------------------------
# Protecao anti-spam dos formularios.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
